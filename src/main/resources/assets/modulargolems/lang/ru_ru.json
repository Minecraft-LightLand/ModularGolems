  "modifier.modulargolems.poseidite": "Посейдит",
  "modifier.modulargolems.poseidite.desc": "Наносит на %s%% больше урона существам, чувствительным к воде или водным существам",
  "modifier.modulargolems.projectile_reject": "Отклонение Проектов",
